# Configure these locally; never commit real keys.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Confirm the currently available NVIDIA Nemotron model ID in your Token Factory account.
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# Used for finding threads, contradictions (Investigate) and gaps. Leave empty to use NEBIUS_MODEL for everything.
NEBIUS_MODEL_REASONING=nvidia/Nemotron-3-Ultra-550b-a55b
TAVILY_API_KEY=
# Optional tuning: parallel model calls (lower if you hit HTTP 429) and per-call timeout in seconds.
# MODEL_CONCURRENCY=3
# MODEL_TIMEOUT_SECONDS=120
# MODEL_RETRIES=2       # retries for rate limits, server errors and timeouts
# MAX_EXTRACT_CHUNKS=6   # how much of each PDF is read: about 4-5 pages per chunk
