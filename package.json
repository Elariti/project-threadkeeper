{
  "name": "threadkeeper-sidecar",
  "version": "0.3.0",
  "private": true,
  "description": "A local-first desktop sidecar with sticky notes, a draggable cat tab, and a Research Desk that turns papers into an evidence-linked argument map.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis",
    "test": "node --test src/research/research.test.mjs src/research/links.test.mjs src/lib/deadlines.test.mjs src/lib/notesModel.test.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "electron-store": "^8.2.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.threadkeeper.sidecar",
    "productName": "Threadkeeper Sidecar",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "directories": {
      "output": "release"
    }
  }
}
